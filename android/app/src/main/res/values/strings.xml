    <!-- Settings: about -->
    <string name="settings_section_about">About</string>
    <string name="settings_about_body">HyperHLE-Reborn is a high-level emulator for iPhone OS apps, built on touchHLE. The emulator core keeps running unchanged underneath this Material 3 Expressive interface — settings here are applied as launch options every time you start a game. Per-app options can still be tweaked in touchHLE_options.txt inside the apps folder.</string>

